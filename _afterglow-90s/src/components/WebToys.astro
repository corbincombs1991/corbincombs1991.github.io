<section class="radio-window" aria-labelledby="radio-title" data-afterglow-radio>
  <div class="radio-titlebar"><h2 id="radio-title">AFTERGLOW RADIO</h2><span aria-hidden="true">♪</span></div>
  <div class="radio-body">
    <p class="radio-caption">MIDI-ish mood / original little loop</p>
    <div class="cassette" aria-hidden="true">
      <div class="cassette-label"><span>AFTERGLOW MIX</span><span>SIDE A</span></div>
      <div class="cassette-tape"><span class="cassette-reel"></span><i></i><span class="cassette-reel"></span></div>
      <div class="cassette-bottom"></div>
    </div>
    <button class="radio-toggle" type="button" aria-pressed="false" aria-describedby="radio-status" data-radio-toggle><span aria-hidden="true">▶</span> PLAY THE MIX</button>
    <p class="radio-status" id="radio-status" role="status" data-radio-status>Sound is off. You call the shots.</p>
    <noscript><p class="radio-status">This little synth needs JavaScript.</p></noscript>
  </div>
</section>

<style>
  .radio-window { color: #15152a; background: #c4c4c4; border: 2px solid; border-color: #fff #45454d #45454d #fff; padding: 3px; box-shadow: 3px 3px 0 #0006; font-family: Verdana, Arial, sans-serif; min-width: 0; }
  .radio-titlebar { display: flex; align-items: center; justify-content: space-between; gap: 8px; background: linear-gradient(90deg, #17075b, #5844ac); padding: 6px 8px; color: #fff; }
  .radio-titlebar h2 { margin: 0; color: inherit; font: bold 12px/1.3 Verdana, Arial, sans-serif; letter-spacing: .04em; }
  .radio-titlebar > span { color: #d6ff3f; font-size: 18px; line-height: 1; }
  .radio-body { padding: 12px; }
  .radio-caption { margin: 0 0 11px; font: 10px/1.6 'Courier New', monospace; text-align: center; }
  .cassette { max-width: 225px; margin: 0 auto 13px; padding: 8px 10px 0; background: #272637; border: 2px solid #0d0c15; border-radius: 7px; box-shadow: inset 1px 1px #6c6a7f; }
  .cassette-label { background: #c9f447; color: #272637; border-radius: 3px 3px 0 0; padding: 5px 7px 12px; display: flex; align-items: center; justify-content: space-between; gap: 4px; font: bold 10px/1.5 'Courier New', monospace; border-bottom: 5px solid #a66de5; }
  .cassette-label span:last-child { font-size: 8px; }
  .cassette-tape { width: 78%; margin: -8px auto 0; display: flex; align-items: center; justify-content: space-between; padding: 1px 7px; border: 2px solid #0d0c15; border-radius: 6px; color: #ddd; background: #11101d; }
  .cassette-reel { display: block; width: 24px; height: 24px; flex: 0 0 24px; margin: 3px 0; border: 5px solid #ddd; border-radius: 50%; box-shadow: inset 0 0 0 2px #65543e; }
  .cassette-tape i { width: 30%; height: 12px; background: #65543e; border: 2px solid #8d8797; }
  .cassette-bottom { width: 65%; height: 15px; margin: 11px auto 0; border: 1px solid #686474; border-bottom: 0; clip-path: polygon(10% 0,90% 0,100% 100%,0 100%); }
  .radio-toggle { box-sizing: border-box; width: 100%; min-height: 38px; padding: 8px; border: 2px solid; border-color: #fff #45454d #45454d #fff; background: #c4c4c4; color: #15152a; font: bold 11px/1.4 Verdana, Arial, sans-serif; cursor: pointer; }
  .radio-toggle:hover { background: #d2d2d2; }
  .radio-toggle:active, .radio-toggle[aria-pressed='true'] { border-color: #45454d #fff #fff #45454d; background: #d6ff65; }
  .radio-toggle:focus-visible { outline: 2px dashed #17075b; outline-offset: 3px; }
  .radio-toggle:disabled { cursor: not-allowed; color: #56515f; }
  .radio-toggle > span { padding-right: 5px; }
  .radio-status { min-height: 2.8em; margin: 10px 0 0; font: 10px/1.5 'Courier New', monospace; text-align: center; overflow-wrap: anywhere; }
  @media (prefers-reduced-motion: reduce) { .radio-window *, .radio-window *::before, .radio-window *::after { animation: none !important; transition: none !important; } }
</style>

<script>
  const radio = document.querySelector<HTMLElement>('[data-afterglow-radio]');
  const radioButton = radio?.querySelector<HTMLButtonElement>('[data-radio-toggle]');
  const radioStatus = radio?.querySelector<HTMLElement>('[data-radio-status]');
  if (radioButton && radioStatus) {
    const AudioEngine = window.AudioContext || (window as Window & { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
    let context: AudioContext | undefined;
    let master: GainNode | undefined;
    let playing = false;
    let scheduler: ReturnType<typeof setInterval> | undefined;
    let step = 0;
    let nextTime = 0;
    const notes = new Set<OscillatorNode>();
    // An original four-bar phrase; every sound is made here, after a click.
    const melody = [72, 0, 76, 79, 0, 76, 74, 0, 71, 0, 74, 79, 0, 74, 76, 0, 69, 0, 72, 76, 0, 79, 76, 72, 67, 0, 71, 74, 0, 71, 67, 0];
    const bass = [48, 47, 45, 43];
    const stepSeconds = 60 / 108 / 2;

    function tone(midi: number, time: number, duration: number, waveform: OscillatorType, volume: number) {
      if (!context || !master) return;
      const oscillator = context.createOscillator();
      const envelope = context.createGain();
      oscillator.type = waveform;
      oscillator.frequency.value = 440 * Math.pow(2, (midi - 69) / 12);
      envelope.gain.setValueAtTime(0, time);
      envelope.gain.linearRampToValueAtTime(volume, time + .012);
      envelope.gain.exponentialRampToValueAtTime(.001, time + duration);
      oscillator.connect(envelope);
      envelope.connect(master);
      notes.add(oscillator);
      oscillator.onended = () => { notes.delete(oscillator); oscillator.disconnect(); envelope.disconnect(); };
      oscillator.start(time);
      oscillator.stop(time + duration + .02);
    }

    function schedule() {
      if (!context || !playing) return;
      while (nextTime < context.currentTime + .16) {
        const note = melody[step];
        if (note) tone(note, nextTime, stepSeconds * .82, 'square', .07);
        if (step % 2 === 0) tone(bass[Math.floor(step / 8)], nextTime, stepSeconds * 1.6, 'triangle', .15);
        nextTime += stepSeconds;
        step = (step + 1) % melody.length;
      }
    }

    function stop(message = 'Sound is off. Your mixtape can wait.') {
      playing = false;
      if (scheduler !== undefined) clearInterval(scheduler);
      scheduler = undefined;
      for (const oscillator of notes) { try { oscillator.stop(); } catch { /* Already ended. */ } }
      notes.clear();
      if (context && master) master.gain.setValueAtTime(0, context.currentTime);
      radioButton!.setAttribute('aria-pressed', 'false');
      radioButton!.textContent = '▶ PLAY THE MIX';
      radioStatus!.textContent = message;
    }

    if (!AudioEngine) {
      radioButton.disabled = true;
      radioStatus.textContent = 'Your browser cannot play this little synth. The shop still rocks.';
    } else {
      radioButton.addEventListener('click', async () => {
        if (playing) { stop(); return; }
        radioButton.disabled = true;
        try {
          if (!context) {
            context = new AudioEngine();
            master = context.createGain();
            master.gain.value = 0;
            master.connect(context.destination);
          }
          await context.resume();
          if (context.state !== 'running' || document.hidden) throw new Error('Audio is unavailable.');
          master!.gain.setValueAtTime(.38, context.currentTime);
          playing = true;
          step = 0;
          nextTime = context.currentTime + .04;
          schedule();
          scheduler = setInterval(schedule, 80);
          radioButton.setAttribute('aria-pressed', 'true');
          radioButton.textContent = '■ STOP THE MIX';
          radioStatus.textContent = 'Now playing: Afterglow after hours. Stops when you leave this tab.';
        } catch {
          stop('Sound could not start. Try again, or enjoy the quiet.');
        } finally {
          radioButton.disabled = false;
        }
      });
      document.addEventListener('visibilitychange', () => { if (document.hidden && playing) stop('Paused when you left the tab. Press play to start again.'); });
      window.addEventListener('pagehide', () => { stop(); void context?.close(); context = undefined; master = undefined; });
    }
  }
</script>
