---
import Layout from '../../layouts/Layout.astro';
import { url } from '../../lib/urls';
import { shop, products, checkedDate } from '../../data/shop';
---
<Layout title="Shop vintage" description="Find your next favorite at Afterglow Vintage. Browse available pieces and shop securely on Depop." current="shop/">
  <section class="page-intro section"><p class="eyebrow">THE SHOP / FIND YOUR NEXT FAVORITE</p><h1>One more<br /><em>great find.</em></h1><p class="lead">Pieces with personality. A new chapter in your wardrobe.</p></section>
  <div class="shop-controls"><div class="product-filters" role="group" aria-label="Filter featured pieces"><button type="button" data-filter="All" aria-pressed="true">All pieces</button>{['Floral', 'Graphic', 'Travel'].map(category => <button type="button" data-filter={category} aria-pressed="false">{category}</button>)}</div><p id="product-count" aria-live="polite">{products.length} featured pieces</p></div>
  <p class="catalog-note">From our Depop shop · Checked {checkedDate}. Prices in USD; confirm current price and availability on Depop.</p>
  {products.length > 0 && <section class="section product-grid" aria-label="Featured Depop pieces">{products.map(product => <a class="product-card" data-category={product.category} href={product.url} target="_blank" rel="noopener noreferrer"><img src={product.image.startsWith('https:') ? product.image : url(product.image)} alt={product.name} width="800" height="800" loading="lazy" /><span class="eyebrow">{product.category} / {product.size}</span><h2>{product.name}</h2><p>{product.price} <span>Check on Depop ↗</span></p></a>)}</section>}
  <section class="section depop-panel"><div class="depop-mark" aria-hidden="true">d.</div><div><p class="eyebrow">THE AFTERGLOW SHOP ON DEPOP</p><h2>{shop.depopUrl ? 'The latest finds.' : 'Good things are coming.'}<br /><em>{shop.depopUrl ? 'All in one place.' : 'Stay in the glow.'}</em></h2><p>{shop.depopUrl ? 'Browse our current collection on Depop for availability, prices, measurements, and detailed photos. Found your piece? Message us and check out there.' : 'The Afterglow collection is being connected. In the meantime, explore the edit for a little outfit inspiration.'}</p>{shop.depopUrl ? <a class="button" href={shop.depopUrl} target="_blank" rel="noopener noreferrer">Shop {shop.handle || 'Afterglow'} on Depop ↗</a> : <a class="button" href={url('lookbook/')}>Explore the edit ↗</a>}<p class="small-copy">{shop.depopUrl ? 'Opens Depop in a new tab. Prices, stock, shipping, and checkout are managed on Depop.' : 'Product availability and checkout will be handled through Depop.'}</p></div></section>
  <section class="section principles"><div><span class="eyebrow">01 / FIND IT</span><h3>Meet your next favorite.</h3><p>Browse the latest listings on Depop. Availability can change as pieces find new homes.</p></div><div><span class="eyebrow">02 / CHECK THE DETAILS</span><h3>Fit comes first.</h3><p>Read the listing, review the measurements and condition, and ask the seller if you need more information.</p></div><div><span class="eyebrow">03 / MAKE IT YOURS</span><h3>Keep it on Depop.</h3><p>Message the seller and complete your purchase through the Depop listing.</p></div></section>
</Layout>

<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-category]');
  const count = document.querySelector('#product-count');
  for (const filter of filters) filter.addEventListener('click', () => {
    let visible = 0;
    filters.forEach(button => button.setAttribute('aria-pressed', String(button === filter)));
    cards.forEach(card => { card.hidden = filter.dataset.filter !== 'All' && filter.dataset.filter !== card.dataset.category; if (!card.hidden) visible++; });
    if (count) count.textContent = `${visible} featured ${visible === 1 ? 'piece' : 'pieces'}`;
  });
</script>
