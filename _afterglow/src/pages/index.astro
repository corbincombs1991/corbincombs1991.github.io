---
import Layout from '../layouts/Layout.astro';
import { url } from '../lib/urls';
import { products, checkedDate } from '../data/shop';
---
<Layout title="Vintage. Turned all the way up." description="Afterglow Vintage, Indianapolis. 90s attitude, clothes with a past, and zero interest in blending in. Discover the edit and shop real vintage finds on Depop.">
  <section class="zine-cover" aria-labelledby="cover-title">
    <div class="issue-line"><span>INDEPENDENT STYLE / INDIANAPOLIS</span><span>ISSUE 002 — NO EXPIRATION DATE</span><span class="issue-price">GOOD TASTE. BAD HABITS.</span></div>
    <div class="masthead"><h1 id="cover-title">AFTERGLOW</h1><span class="masthead-tag">VINTAGE<br />& OTHER<br />GOOD STUFF.</span></div>
    <div class="cover-stage" id="cover-stage">
      <div class="plaid-scrap" aria-hidden="true"></div>
      <figure class="cover-photo"><img src={url('images/zine/afterglow-store.jpg')} width="3072" height="4096" alt="Inside Afterglow Vintage, with clothing racks, vintage wall displays, a teal jacket, and a cat in the aisle" fetchpriority="high" /><figcaption>INSIDE AFTERGLOW / <a href="https://www.instagram.com/afterglowvintageindy/p/Ddo3JvWqDpo/" target="_blank" rel="noopener noreferrer">FROM @AFTERGLOWVINTAGEINDY ↗</a></figcaption></figure>
      <div class="cover-headline"><span>WORN</span><span>LOUD.</span></div>
      <div class="cover-intro"><p class="eyebrow">1996 ATTITUDE.<br />2026 EXECUTION.</p><p>For the thrift-store romantics.<br />The mixtape makers.<br />The beautifully overdressed.</p><a class="button cover-shop" href={url('shop/')}>SHOP THE GOOD STUFF <span aria-hidden="true">↗</span></a></div>
      <a class="cover-polaroid" href="https://www.instagram.com/afterglowvintageindy/p/DeXkN_xkion/" target="_blank" rel="noopener noreferrer"><span class="tape" aria-hidden="true"></span><img src={url('images/zine/afterglow-live-performance.jpg')} width="1365" height="914" alt="A vocalist in sunglasses at a microphone, with a bassist performing behind, at the Afterglow Vintage Market" /><span class="handwritten">play it loud.</span><span class="polaroid-link">FROM @AFTERGLOWVINTAGEINDY ↗</span></a>
      <a class="cover-burst" href={url('shop/')}><span>OLD<br />CLOTHES.<br /><b>NEW<br />PROBLEMS.</b><span class="burst-arrow" aria-hidden="true">↗</span></span></a>
      <div class="cover-note"><span class="note-cross" aria-hidden="true">✕</span><p>Previously loved.<br />Still a little <br /><em>out of control.</em></p></div>
      <svg class="cover-scribble" viewBox="0 0 180 140" fill="none" aria-hidden="true"><path d="M13 16C89 10 156 71 108 92C68 111 65 61 99 48C124 38 166 76 151 127M151 127L128 111M151 127L171 103" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <button class="remix-button" type="button" aria-pressed="false" aria-label="Remix the cover collage"><span aria-hidden="true">↻</span> REMIX THE COVER</button>
      <span class="cover-side" aria-hidden="true">SIDE A / PLAY IT LOUD</span>
    </div>
    <div class="cover-bottom"><span>★ NO DRESS CODE. NO TIME MACHINE REQUIRED.</span><a href="#the-drop">KEEP DIGGING ↓</a></div>
  </section>

  <section id="the-drop" class="section drop-section">
    <div class="section-heading" data-reveal><div><p class="eyebrow">01 / SELECTED FROM THE RACK</p><h2>FINDERS<br /><em>KEEPERS.</em></h2></div><div class="drop-note"><span class="handwritten">yeah, you need it.</span><p>Real vintage. Real character.<br />Straight from our Depop shop.</p><a class="text-link" href={url('shop/')}>SEARCH THE FEATURED FINDS ↗</a></div></div>
    <div class="product-grid home-products">{[products[0],products[3],products[4]].map((product,index) => <a class="product-card" href={product.url} target="_blank" rel="noopener noreferrer" data-reveal><div class="product-photo"><img src={url(product.image)} width="800" height="800" loading="lazy" alt={product.name} /><span class="product-number" aria-hidden="true">NO. 0{index + 1}</span><span class="product-price">{product.price}</span></div><span class="eyebrow">{product.category} / SIZE {product.size}</span><h3>{product.name}</h3><p>MEET YOUR NEW OLD FAVORITE <span>DEPOP ↗</span></p></a>)}</div>
    <p class="image-note">Listings checked {checkedDate}. Prices in USD. Current availability and checkout on Depop.</p>
  </section>

  <div class="cut-strip" aria-label="Wear it your way"><span>WEAR IT OUT</span><span>WEAR IT YOUR WAY</span><span>WEAR IT AGAIN</span></div>

  <section id="the-edit" class="section cut-paste-section">
    <div class="editorial-copy" data-reveal><p class="eyebrow">02 / CUT. PASTE. REPEAT.</p><h2>NOTHING<br /><span class="outlined">MATCHES.</span><br /><em>IT WORKS.</em></h2><p class="editorial-deck">Plaid with florals. Band tees with everything. The jacket that’s been through it. This is your permission to get a little weird.</p><a class="button button-yellow" href={url('lookbook/')}>ENTER THE LOOKBOOK ↗</a><span class="handwritten scribble-caption">more is more. ↗</span></div>
    <a class="editorial-collage" href={url('lookbook/')} data-reveal><img src={url('images/zine/grunge-collage.webp')} width="1024" height="1536" loading="lazy" alt="Grunge fashion collage with layered plaid, leather, denim, roses, and boots" /><span class="editorial-stamp">ZERO<br />RULES.</span><span class="collage-label">THE AFTERGLOW FIELD GUIDE / VOL. 02</span></a>
    <p class="editorial-disclaimer">Editorial imagery sets the mood. Shop listings show the actual pieces.</p>
  </section>

  <section class="section manifesto zine-manifesto">
    <div class="manifesto-sidebar"><span class="eyebrow">03 / THE MANIFESTO</span><span class="handwritten">a love letter<br />to the leftovers.</span></div>
    <div class="manifesto-main" data-reveal><h2>GOOD CLOTHES<br />DESERVE A<br /><em>SECOND ACT.</em></h2><div class="manifesto-columns"><p>The stuff you remember. The stuff you wish you’d kept. The stuff someone else gave up on, right before it became your favorite.</p><p>Afterglow is for clothes with character and people with their own point of view. A little faded. A little loud. Always worth another spin.</p></div><a class="text-link" href={url('about/')}>READ THE AFTERGLOW STORY ↗</a></div>
  </section>

  <section class="last-call"><p class="eyebrow">YOU DIDN'T COME HERE TO BLEND IN.</p><a href={url('shop/')}>GET INTO IT.<span aria-hidden="true">↗</span></a><span class="handwritten">your wardrobe called.</span></section>
</Layout>
<script>
  const remix = document.querySelector<HTMLButtonElement>('.remix-button');
  const cover = document.querySelector('#cover-stage');
  remix?.addEventListener('click', () => {
    const active = cover?.classList.toggle('remixed') ?? false;
    remix.setAttribute('aria-pressed', String(active));
    const label = cover?.querySelector('.cover-side');
    if (label) label.textContent = active ? 'SIDE B / MAKE SOME NOISE' : 'SIDE A / PLAY IT LOUD';
  });
</script>
